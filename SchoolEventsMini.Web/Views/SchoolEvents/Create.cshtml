@{
    ViewData["Title"] = "Създай събитие";
}

<h2>Създай събитие</h2>

<form asp-controller="SchoolEvents" asp-action="Create" method="post">

    <div class="form-group mb-3">
        <label for="event_name">Име на събитието</label>
        <input type="text"
               class="form-control"
               name="Name"
               id="event_name"
               placeholder="Въведи име на събитието"
               required />
    </div>

    <div class="form-group mb-3">
        <label for="event_date">Дата</label>
        <input type="date"
               class="form-control"
               name="Date"
               id="event_date"
               required />
    </div>

    <div class="form-group mb-3">
        <label for="event_place">Място</label>
        <input type="text"
               class="form-control"
               name="Place"
               id="event_place"
               placeholder="Въведи място"
               required />
    </div>

    <div class="form-group mb-3">
        <label for="event_category">Категория</label>
        <select class="form-control" name="Category" id="event_category">
            <option value="Празник">Празник</option>
            <option value="Спорт">Спорт</option>
            <option value="Образование">Образование</option>
            <option value="Култура">Култура</option>
            <option value="Друго">Друго</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label for="event_description">Описание</label>
        <textarea class="form-control"
                  name="Description"
                  id="event_description"
                  rows="4"
                  placeholder="Въведи описание на събитието"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">Запази</button>

    <a asp-controller="SchoolEvents"
       asp-action="Index"
       class="btn btn-secondary">
        Назад
    </a>

</form>
