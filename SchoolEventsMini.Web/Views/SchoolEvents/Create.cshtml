@using SchoolEventsMini.Data.Enums

<h1>Добави училищно събитие</h1>

<form method="post" action="create">
    <div class="form-group">
        <label for="event_name">Име на събитието</label>
        <input type="text" class="form-control" name="name" id="event_name" required>
    </div>

    <div class="form-group">
        <label for="event_date">Дата</label>
        <input type="date" class="form-control" name="date" id="event_date" required>
    </div>

    <div class="form-group">
        <label for="event_place">Място</label>
        <input type="text" class="form-control" name="place" id="event_place" required>
    </div>

    <div class="form-group">
        <label for="event_category">Категория</label>
        <select class="form-control" name="category" id="event_category">
            @foreach (var category in Enum.GetValues<SchoolEventCategory>())
            {
                <option value="@category">@category</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="event_description">Описание</label>
        <textarea class="form-control" name="description" id="event_description"></textarea>
    </div>

    <div class="form-group">
        <label for="organizer_id">ID на организатора</label>
        <input type="text" class="form-control" name="organizerId" id="organizer_id" required>
    </div>

    <button type="submit" class="btn btn-primary my-3">Запази</button>
</form>